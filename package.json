  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rioj7/command-variable.git"
  },
  "scripts": {
    "postinstall": "node scripts/install-vscode-stub.js",
    "vscode:stub": "node scripts/install-vscode-stub.js",
    "build": "rollup -c --environment BUILD:production",
    "dev": "rollup -c --environment BUILD:development",
    "watch": "rollup -c -w --environment BUILD:development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node scripts/install-vscode-stub.js && vitest run",
    "test:coverage": "node scripts/install-vscode-stub.js && vitest run --coverage",
    "test:integration": "node scripts/build-and-test-integration.js",
    "check:bundle": "node scripts/check-bundle.js",
    "check:audit": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run lint && npm run test:coverage && npm run dev && npm run check:bundle && npm run check:audit",
    "test": "npm run verify",
    "package": "npm run build && node scripts/package.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.2",
    "@types/vscode": "~1.138.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "rollup": "^4.63.4",
    "vitest": "^5.0.2"
  }
}
